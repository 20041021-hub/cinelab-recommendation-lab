# 实验六 S2 + 创新点 A：API 镜像（课程离线镜像 + 学生依赖 + 学生代码）
#
# 课程镜像 cinelab-offline/api:1.3.0-a1 已经带 httpx（外部模型 HTTP 客户端），S2 不需要
# 新增依赖；但实验五 S3 的 Kafka 生产端要 kafka-python，实验六叠加文件同样要带上它，
# 所以这里复用实验五以 wheel 形式提交的离线依赖（deployment/lab5/vendor）。
#
#   docker build -f deployment/lab6/Dockerfile.api -t cinelab-local/api:lab6 .
#
# 依赖清单与理由见 deployment/lab6/readme.md（课程 backend/requirements.lock.txt 由教师维护，
# 学生不改动，避免破坏 deployment.verify 的摘要校验）。
FROM cinelab-offline/api:1.3.0-a1

COPY deployment/lab5/vendor /tmp/lab5-vendor
# 课程镜像以 uid 10001 运行，系统 site-packages 不可写；装到系统目录后立刻切回原用户
USER root
RUN pip install --no-index --find-links=/tmp/lab5-vendor \
        --target /usr/local/lib/python3.12/site-packages kafka-python==2.2.15 \
    && rm -rf /tmp/lab5-vendor
USER 10001

COPY backend /app/backend
COPY recommender /app/recommender
COPY scripts /app/scripts