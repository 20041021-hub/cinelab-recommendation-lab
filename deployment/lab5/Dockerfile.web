# 实验五：Web 镜像（课程离线 nginx 镜像 + 本仓库构建出的前端产物）
#
#   cd frontend && npm run build          # 先产出 frontend/dist
#   docker build -f deployment/lab5/Dockerfile.web -t cinelab-local/web:lab5 .
#
# 前端只改了学生自己的页面/组件与构建期数据，不需要动 nginx 配置。
FROM cinelab-offline/web:1.3.0-a1
COPY frontend/dist /usr/share/nginx/html