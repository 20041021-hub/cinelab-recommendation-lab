# 实验五 S3：API 镜像（课程离线镜像 + 学生依赖 + 学生代码）
#
# 课程镜像 cinelab-offline/api:1.3.0-a1 里没有 Kafka 客户端；本机 Docker Hub 不可达，
# 无法用 deployment/build.ps1 重新构建课程基础镜像，因此用离线镜像做底座叠加：
#
#   docker build -f deployment/lab5/Dockerfile.api -t cinelab-local/api:lab5 .
#
# kafka-python 以 wheel 形式随仓库提交（deployment/lab5/vendor），构建时不需要外网。
# 依赖清单与理由见 deployment/lab5/readme.md（课程 backend/requirements.lock.txt 由教师维护，
# 学生不改动，避免破坏 deployment.verify 的摘要校验）。
FROM cinelab-offline/api:1.3.0-a1

COPY deployment/lab5/vendor /tmp/lab5-vendor
# 课程镜像以 uid 10001 运行，系统 site-packages 不可写；装到系统目录后立刻切回原用户
USER root
RUN pip install --no-index --find-links=/tmp/lab5-vendor \
        --target /usr/local/lib/python3.12/site-packages kafka-python==2.2.15 \
    && rm -rf /tmp/lab5-vendor
USER 10001

COPY backend /app/backend
COPY recommender /app/recommender
COPY scripts /app/scripts